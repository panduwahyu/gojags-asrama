{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "dev:nuxt": "npm --prefix frontend run dev",
        "build:nuxt": "npm --prefix frontend run build",
        "dev:asrama": "concurrently --kill-others --names laravel,nuxt \"php artisan serve --host=127.0.0.1 --port=8000\" \"npm --prefix frontend run dev\""
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "jsqr": "^1.4.0"
    }
}
